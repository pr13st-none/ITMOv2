{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-review-agent",
  "small_model": "ollama/itmo-review-agent",
  "default_agent": "build",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {"baseURL": "http://127.0.0.1:11434/v1"},
      "models": {
        "itmo-review-agent": {
          "name": "Working local agent (Qwen3 8B)",
          "limit": {"context": 16384, "output": 2048}
        }
      }
    }
  },
  "permission": {
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {"*": "allow", "git push*": "deny"}
  }
}
